# ─────────────────────────────────────────────────────────────
#  KIKY 2.0 — PRODUCTION environment template
#  Copy → server/.env on your host. NEVER commit the filled version.
#  Every value below is a PLACEHOLDER. Fill with real values only
#  on the deployed host (set via the host's env-var UI, not a file
#  you can push, so secrets can't leak into git).
# ─────────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=production

# MongoDB Atlas (your own cluster — do NOT reuse a shared demo URI)
MONGODB_URI=mongodb+srv://<REAL_USER>:<REAL_PASSWORD>@<REAL_CLUSTER>.mongodb.net/<YOUR_DB>

# Auth
JWT_SECRET=<64+ char urandom string>
JWT_EXPIRES_IN=7d

# ── Google OAuth — the pieces that unblock phone sign-in ─────
# These TWO must point at the SAME public origin you used to
# register the app in Google Cloud (APIs & Services → Credentials
# → OAuth 2.0 Client → Authorized redirect URIs):
#   https://<YOUR_HOST>/auth/google/callback
# and the SPA origin in Authorized JavaScript origins:
#   https://<YOUR_HOST>
GOOGLE_CLIENT_ID=<REAL_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<REAL_CLIENT_SECRET>
# Change these two lines from localhost to the real host — this is
# the single most common reason Google login "keeps failing" on a
# phone: it redirects to localhost, which is the PHONE itself.
GOOGLE_CALLBACK_URL=https://<YOUR_HOST>/auth/google/callback
FRONTEND_URL=https://<YOUR_HOST>

# Web Push (generate fresh keys for prod — never reuse dev keys)
VAPID_PUBLIC_KEY=<replace-with-prod-public-key>
VAPID_PRIVATE_KEY=<replace-with-prod-private-key>
VAPID_SUBJECT=mailto:<your-real-contact-email>

# Email / SMTP — real relay creds (mailgun/sendgrid/etc), not the dev fallback
SMTP_HOST=smtp.<your-provider>.com
SMTP_PORT=587
SMTP_USER=<real-smtp-user>
SMTP_PASS=<real-smtp-pass>
SMTP_SECURE=false

# Admin / seed
ADMIN_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_PASSWORD=Demo@1234

# Mongo retry
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY_MS=5000
